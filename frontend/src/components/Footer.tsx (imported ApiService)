import React from 'react';
import ApiService from './ApiService';

const Footer: React.FC = () => {
  const [data, setData] = React.useState<ResponseData | null>(null);

  React.useEffect(() => {
    ApiService.getFooterData().then((response) => setData(response));
  }, []);

  return (
    <div className="container-fluid p-1 my-bg-color text-center text-white mt-3">
      <p className="fs-4 text-center">
        {data?.errorMsg ? (
          <span>{data.errorMsg}</span>
        ) : (
          '&copy; md.talal.wasim'
        )}
      </p>
    </div>
  );
};

export default Footer;